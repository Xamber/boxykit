{
  "name": "boxykit",
  "version": "0.1.1",
  "description": "A small, flat UI kit: plain CSS with an optional React layer that writes the same classes.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xamber/boxykit.git",
    "directory": "packages/boxykit"
  },
  "homepage": "https://boxykit.temka.fi",
  "bugs": "https://github.com/Xamber/boxykit/issues",
  "keywords": [
    "css",
    "ui",
    "react",
    "components",
    "design-tokens"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    "./css": {
      "types": "./dist/css/css.d.ts",
      "default": "./dist/css/boxy.css"
    },
    "./css/tokens": {
      "types": "./dist/css/css.d.ts",
      "default": "./dist/css/tokens.css"
    },
    "./css/reset": {
      "types": "./dist/css/css.d.ts",
      "default": "./dist/css/reset.css"
    },
    "./css/*": {
      "types": "./dist/css/css.d.ts",
      "default": "./dist/css/components/*.css"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/build-css.js && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
